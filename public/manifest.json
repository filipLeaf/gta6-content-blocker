{
  "manifest_version": 3,
  "name": "Content Blocker for GTA 6",
  "version": "0.1.0",
  "description": "Blurs or hides GTA 6 content and spoilers on YouTube, X and Reddit. Open source, no tracking.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": ["storage"],
  "host_permissions": ["*://*.youtube.com/*", "*://*.x.com/*", "*://*.twitter.com/*", "*://*.reddit.com/*"],
  "content_scripts": [
    {
      "matches": ["*://*.youtube.com/*", "*://*.x.com/*", "*://*.twitter.com/*", "*://*.reddit.com/*"],
      "js": ["content/content.js"],
      "css": ["content/blocker.css"],
      "run_at": "document_start"
    }
  ],
  "action": {
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    },
    "default_title": "Content Blocker for GTA 6"
  },
  "options_ui": {
    "page": "options/options.html",
    "open_in_tab": true
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "gta6-content-blocker@extension",
      "strict_min_version": "128.0",
      "data_collection_permissions": { "required": ["none"] }
    }
  }
}
