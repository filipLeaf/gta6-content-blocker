{
  "name": "gta6-spoiler-blocker",
  "version": "0.1.0",
  "private": true,
  "description": "Browser extension that blurs GTA VI spoilers on YouTube, X and Reddit.",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "build": "node scripts/build.mjs",
    "watch": "node scripts/build.mjs --watch",
